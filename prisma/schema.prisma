// Generador del cliente de Prisma
generator client {
  provider = "prisma-client-js"
}

// Configuración de la base de datos
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Roles globales de los usuarios en la plataforma
enum Role {
  BUYER
  SUPPLIER
  ADMIN
}

// Sectores de la industria a los que puede pertenecer una empresa
enum IndustrySector {
  AGRICULTURA
  CONSTRUCCION
  ESTADO_GOBIERNO
  MANUFACTURA
  MEDICAL_SALUD
  RETAIL_COMERCIO
  SERVICIOS_PROFESIONALES
  TECNOLOGIA
  TRANSPORTE_LOGISTICA
  OTRO
}

// Departamentos de Guatemala
enum Location {
  ALTA_VERAPAZ
  BAJA_VERAPAZ
  CHIMALTENANGO
  CHIQUIMULA
  EL_PROGRESO
  ESCUINTLA
  GUATEMALA
  HUEHUETENANGO
  IZABAL
  JALAPA
  JUTIAPA
  PETEN
  QUETZALTENANGO
  QUICHE
  RETALHULEU
  SACATEPEQUEZ
  SAN_MARCOS
  SANTA_ROSA
  SOLOLA
  SUCHITEPEQUEZ
  TOTONICAPAN
  ZACAPA
}

// Roles de usuario dentro de una compañía específica (permisos de acceso)
enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// Estados posibles en el ciclo de vida de una Solicitud de Cotización (RFQ)
enum RfqStatus {
  DRAFT_PENDING_APPROVAL
  OPEN
  EVALUATING
  AWARDED
  PENDING_DELIVERY
  DELIVERED
  CLOSED
}

// Estados de una oferta/cotización (Bid) recibida por un proveedor
enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Términos de pago aceptados para las transacciones
enum PaymentTerms {
  CASH
  NET_30
  NET_60
}

// Categorías principales para clasificar los RFQs
enum RfqCategory {
  TECH
  OFFICE
  CONSTRUCTION
  SERVICES
  OTHER
}

// Modelo de Empresa (Comprador o Proveedor) en la plataforma
model Company {
  id         String         @id @default(cuid())
  nit        String         @unique
  name       String
  industry   IndustrySector
  department Location
  isVerified Boolean        @default(false)
  kycStatus  String         @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  users           User[]
  rfqs            Rfq[]
  bids            Bid[]
  invitations     Invitation[]
  questions       Question[]
  authoredReviews Review[]     @relation("AuthoredReviews")
  receivedReviews Review[]     @relation("ReceivedReviews")
  documents       CompanyDocument[]
  sentMessages    Message[]    @relation("SentMessages")
  receivedMessages Message[]   @relation("ReceivedMessages")
}

// Documentos legales asociados a una empresa (ej. RTU, Patente)
model CompanyDocument {
  id        String   @id @default(cuid())
  type      String   // RTU, PATENTE, REPRESENTACION_LEGAL
  url       String   // URL de datos o S3
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Modelo de Usuario (perteneciente a una Empresa)
model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  password            String?
  name                String?
  role                Role        @default(BUYER)
  companyRole         CompanyRole @default(OWNER)
  onboardingComplete  Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])
}

// Modelo de Solicitud de Cotización (Request for Quotation)
model Rfq {
  id               String        @id @default(cuid())
  title            String
  description      String
  budget           Decimal
  status           RfqStatus     @default(OPEN)
  needsApproval    Boolean       @default(false)
  approvedById     String?
  deadline         DateTime
  deliveryLocation String?
  paymentTerms     PaymentTerms?
  category         RfqCategory?
  aiAnalysis       String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Seguimiento de entrega
  awardedBidId         String?
  deliveryConfirmedAt  DateTime?
  deliveryConfirmedBy  String?

  bids      Bid[]
  items     RfqItem[]
  questions Question[]
  reviews   Review[]
  messages  Message[]
}

// Artículo o ítem específico dentro de un RFQ
model RfqItem {
  id       String @id @default(cuid())
  name     String
  quantity Int
  unit     String

  rfqId String
  rfq   Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  bidItems BidItem[]
}

// Oferta o cotización presentada por un proveedor para un RFQ
model Bid {
  id               String    @id @default(cuid())
  amount           Decimal
  coverLetter      String
  status           BidStatus @default(PENDING)
  validityDays     Int?
  deliveryLeadTime String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  rfqId String
  rfq   Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  items BidItem[]
}

// Desglose de precios para un artículo específico en una oferta
model BidItem {
  id         String  @id @default(cuid())
  unitPrice  Decimal
  totalPrice Decimal
  remarks    String?

  bidId String
  bid   Bid    @relation(fields: [bidId], references: [id], onDelete: Cascade)

  rfqItemId String
  rfqItem   RfqItem @relation(fields: [rfqItemId], references: [id], onDelete: Cascade)
}

// Invitación enviada por email para unirse a una empresa
model Invitation {
  id        String      @id @default(uuid())
  email     String
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      CompanyRole
  token     String      @unique
  expiresAt DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([email, companyId])
}

// Pregunta de aclaración realizada por un proveedor sobre un RFQ
model Question {
  id        String   @id @default(cuid())
  content   String
  answer    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rfqId     String
  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  companyId String // La empresa que hizo la pregunta
  company   Company  @relation(fields: [companyId], references: [id])
}

// Reseña y calificación de una empresa hacia otra tras finalizar un RFQ
model Review {
  id                    String   @id @default(cuid())
  authorCompanyId       String
  targetCompanyId       String
  rfqId                 String

  ratingQuality         Int      // 1-5 (Producto/Claridad)
  ratingPunctuality     Int      // 1-5 (Entrega/Agilidad)
  ratingCommunication   Int      // 1-5 (Comunicación)
  ratingProfessionalism Int      // 1-5 (Profesionalismo/Resolución)
  comment               String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  authorCompany         Company  @relation("AuthoredReviews", fields: [authorCompanyId], references: [id])
  targetCompany         Company  @relation("ReceivedReviews", fields: [targetCompanyId], references: [id])
  rfq                   Rfq      @relation(fields: [rfqId], references: [id])

  // Una empresa solo puede dejar 1 reseña por RFQ
  @@unique([authorCompanyId, rfqId])
}

// Mensajes de chat directo entre comprador y proveedor
model Message {
  id         String   @id @default(cuid())
  content    String
  
  senderId   String
  receiverId String
  rfqId      String
  
  createdAt  DateTime @default(now())

  rfq        Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sender     Company  @relation("SentMessages", fields: [senderId], references: [id])
  receiver   Company  @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

// Registro de actividades para auditoría y trazabilidad
model ActivityLog {
  id          String   @id @default(cuid())
  action      String   // RFQ_CREATED, BID_SUBMITTED, BID_ACCEPTED, KYC_SUBMITTED, MEMBER_INVITED, etc.
  description String
  metadata    Json?    // Datos extra estructurados (rfqId, bidId, etc.)
  
  userId      String?
  companyId   String?
  
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

// ─── Chat del Agente de Inteligencia Artificial (Nexus) ─────────────────────────────────

// Sesión de conversación con el Agente AI
model NexusConversation {
  id        String   @id @default(cuid())
  title     String?
  userId    String?  // Nulo para usuarios no autenticados en la landing page
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  NexusMessage[]

  @@index([userId, updatedAt])
}

// Mensaje individual dentro de una conversación con el Agente AI
model NexusMessage {
  id             String   @id @default(cuid())
  role           String   // "user" | "assistant" | "system" | "tool"
  content        String   @db.Text
  toolCalls      Json?
  toolResults    Json?

  conversationId String
  conversation   NexusConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}
